{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Nightly sync of one customer's Microsoft Sentinel analytics rules into the MITRE ATT&CK coverage dashboard's board.json in SharePoint."
  },
  "parameters": {
    "workspaceResourceId": {
      "type": "string",
      "metadata": {
        "description": "CHANGE. Full resource ID of the customer's Log Analytics workspace (Sentinel). Workspace > Properties > Resource ID."
      }
    },
    "customerName": {
      "type": "string",
      "metadata": {
        "description": "CHANGE. Customer view name exactly as it appears in the dashboard dropdown (case-insensitive). If no view has this name, one is created."
      }
    },
    "sharePointSiteUrl": {
      "type": "string",
      "metadata": {
        "description": "CHANGE. SharePoint site holding board.json, e.g. https://salus.sharepoint.com/sites/SOC (no trailing slash, no library)."
      }
    },
    "boardFilePath": {
      "type": "string",
      "defaultValue": "/Shared Documents/MITRE/board.json",
      "metadata": {
        "description": "CHANGE. Path to board.json inside the site, starting with the library. The 'Documents' library is 'Shared Documents' in paths."
      }
    },
    "logicAppName": {
      "type": "string",
      "defaultValue": "la-mitre-board-sync",
      "metadata": {
        "description": "Name of the Logic App. Use one per customer, e.g. la-mitre-board-sync-contoso."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region. Defaults to the resource group's region."
      }
    },
    "dryRun": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "CHANGE after first test. true = read and merge but don't write board.json (check the Summary step in run history). Set false to go live."
      }
    },
    "runHour": {
      "type": "int",
      "defaultValue": 2,
      "metadata": {
        "description": "Hour of day (0-23) to run, in timeZone."
      },
      "minValue": 0,
      "maxValue": 23
    },
    "timeZone": {
      "type": "string",
      "defaultValue": "GMT Standard Time",
      "metadata": {
        "description": "Windows time zone name for the schedule. 'GMT Standard Time' = UK, follows BST."
      }
    },
    "techniqueRemap": {
