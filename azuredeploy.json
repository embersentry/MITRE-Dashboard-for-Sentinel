        "T1562.009": "T1688",
        "T1562.010": "T1689",
        "T1562.011": "T1685.003",
        "T1562.012": "T1685.004",
        "T1562.013": "T1686.002",
        "T1574.002": "T1574.001",
        "T1656": "T1684.001",
        "T1672": "T1684.002"
      },
      "metadata": {
        "description": "Every revoked ATT&CK technique ID -> its current replacement, generated from MITRE's ATT&CK v20.0 STIX revoked-by relationships. Valid for the dashboard's v19.2 matrix (v20.0 retired nothing). Only edit to override a mapping."
      }
    },
    "retiredTechniques": {
      "type": "array",
      "defaultValue": [
        "T1026",
        "T1034",
        "T1043",
        "T1051",
        "T1053.004",
        "T1061",
        "T1062",
        "T1064",
        "T1108",
        "T1149",
        "T1153",
        "T1175"
      ],
      "metadata": {
        "description": "Technique IDs MITRE deprecated with no replacement. Rules tagged with these are listed in the run Summary so you can re-tag them."
      }
    },
    "sentinelApiVersion": {
      "type": "string",
      "defaultValue": "2024-09-01",
      "metadata": {
        "description": "Microsoft.SecurityInsights API version used to list analytics rules. Stable versions (including 2024-09-01) do not return the subTechniques property, so rules land only on parent technique tiles. Use a preview version that returns it, e.g. 2024-10-01-preview, to map rules onto the dashboard's sub-technique tiles as well."
      }
    },
    "assignSentinelReader": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Grant the Logic App's managed identity Microsoft Sentinel Reader on the workspace. Needs Owner/User Access Administrator there. Set false if done separately or via Azure Lighthouse."
      }
    },
    "createIntegrationAccount": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "The JavaScript merge step needs an integration account. true = create a Free-tier one. Free is limited to one per region per subscription; set false and fill existingIntegrationAccountId if you already have one."
      }
    },
    "integrationAccountName": {
      "type": "string",
      "defaultValue": "ia-mitre-board-sync",
      "metadata": {
        "description": "Name for the new integration account (only used when createIntegrationAccount is true)."
      }
    },
    "existingIntegrationAccountId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource ID of an existing integration account in the same region (only used when createIntegrationAccount is false)."
      }
    }
  },
  "variables": {
    "wsParts": "[split(parameters('workspaceResourceId'), '/')]",
    "spConnectionName": "[concat(parameters('logicAppName'), '-sharepoint')]",
    "iaId": "[if(parameters('createIntegrationAccount'), resourceId('Microsoft.Logic/integrationAccounts', parameters('integrationAccountName')), parameters('existingIntegrationAccountId'))]"
  },
  "resources": [
    {
      "condition": "[parameters('createIntegrationAccount')]",
      "type": "Microsoft.Logic/integrationAccounts",
      "apiVersion": "2019-05-01",
      "name": "[parameters('integrationAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Free"
      },
      "properties": {
        "state": "Enabled"
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('spConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "[concat('SharePoint - ', parameters('logicAppName'))]",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'sharepointonline')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('spConnectionName'))]",
        "[resourceId('Microsoft.Logic/integrationAccounts', parameters('integrationAccountName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "integrationAccount": {
          "id": "[variables('iaId')]"
        },
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "workspaceResourceId": {
              "type": "String"
            },
            "customerName": {
              "type": "String"
            },
            "sharePointSiteUrl": {
              "type": "String"
            },
            "boardFilePath": {
              "type": "String"
            },
            "sentinelApiVersion": {
              "type": "String"
            },
            "techniqueRemap": {
              "type": "Object"
            },
            "retiredTechniques": {
              "type": "Array"
            },
            "dryRun": {
              "type": "Bool"
            }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "timeZone": "[parameters('timeZone')]",
                "schedule": {
                  "hours": [
                    "[parameters('runHour')]"
                  ],
                  "minutes": [
                    0
                  ]
                }
              }
            }
          },
          "actions": {
            "Config": {
              "type": "Compose",
              "runAfter": {},
              "inputs": {
                "customerName": "@parameters('customerName')",
                "remap": "@parameters('techniqueRemap')",
                "retired": "@parameters('retiredTechniques')"
              }
            },
            "Init_rules": {
              "type": "InitializeVariable",
              "runAfter": {
                "Config": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "variables": [
                  {
                    "name": "rules",
                    "type": "array",
                    "value": []
                  }
                ]
              }
            },
            "Init_nextUrl": {
              "type": "InitializeVariable",
              "runAfter": {
                "Init_rules": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "variables": [
                  {
                    "name": "nextUrl",
                    "type": "string",
                    "value": "https://management.azure.com@{parameters('workspaceResourceId')}/providers/Microsoft.SecurityInsights/alertRules?api-version=@{parameters('sentinelApiVersion')}"
                  }
                ]
              }
            },
            "Page_through_rules": {
              "type": "Until",
              "runAfter": {
                "Init_nextUrl": [
                  "Succeeded"
                ]
              },
              "expression": "@equals(variables('nextUrl'), '')",
              "limit": {
                "count": 50,
                "timeout": "PT1H"
              },
              "actions": {
                "Get_rules_page": {
                  "type": "Http",
                  "runAfter": {},
                  "inputs": {
                    "method": "GET",
                    "uri": "@variables('nextUrl')",
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "audience": "https://management.azure.com/"
                    }
                  }
                },
                "Collect": {
                  "type": "Compose",
                  "runAfter": {
                    "Get_rules_page": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@union(variables('rules'), coalesce(body('Get_rules_page')?['value'], json('[]')))"
                },
                "Set_rules": {
                  "type": "SetVariable",
                  "runAfter": {
                    "Collect": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "name": "rules",
                    "value": "@outputs('Collect')"
                  }
                },
                "Set_nextUrl": {
                  "type": "SetVariable",
                  "runAfter": {
                    "Set_rules": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "name": "nextUrl",
                    "value": "@{coalesce(body('Get_rules_page')?['nextLink'], '')}"
                  }
                }
              }
            },
            "All_rules": {
              "type": "Compose",
              "runAfter": {
                "Page_through_rules": [
                  "Succeeded"
                ]
              },
              "inputs": "@variables('rules')"
            },
            "Get_board_metadata": {
              "type": "ApiConnection",
              "runAfter": {
                "All_rules": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/GetFileByPath",
                "queries": {
                  "path": "@parameters('boardFilePath')",
                  "queryParametersSingleEncoded": true
                }
              }
            },
            "Get_board": {
              "type": "ApiConnection",
              "runAfter": {
                "Get_board_metadata": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/GetFileContentByPath",
                "queries": {
                  "path": "@parameters('boardFilePath')",
                  "inferContentType": false,
                  "queryParametersSingleEncoded": true
                }
              }
            },
            "Board_text": {
              "type": "Compose",
              "runAfter": {
                "Get_board": [
                  "Succeeded"
                ]
              },
              "inputs": "@base64ToString(coalesce(body('Get_board')?['$content'], base64(string(body('Get_board')))))"
            },
            "Merge_into_board": {
              "type": "JavaScriptCode",
              "runAfter": {
                "Board_text": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "code": "// Runs inside the Logic App \"Merge_into_board\" (Execute JavaScript Code) action.\n// Reads three earlier actions: Config, All_rules, Board_text. Returns { content, summary }.\nconst cfg = workflowContext.actions.Config.outputs;\nconst rules = workflowContext.actions.All_rules.outputs || [];\nlet raw = workflowContext.actions.Board_text.outputs;\nconst board = typeof raw === 'string' ? JSON.parse(raw.replace(/^\\uFEFF/, '')) : raw;\n\nconst SEV = { informational: 'Informational', low: 'Low', medium: 'Medium', high: 'High', critical: 'Critical' };\nconst remap = cfg.remap || {};\nconst retired = new Set(cfg.retired || []);\nconst now = new Date().toISOString();\nconst norm = s => String(s || '').trim().toLowerCase();\n\nboard.v = board.v || 3;\nboard.customers = board.customers || [];\nboard.data = board.data || {};\nlet cust = board.customers.find(c => norm(c.name) === norm(cfg.customerName));\nlet created = false;\nif (!cust) {\n  cust = { id: 'c' + Math.random().toString(36).slice(2, 9), name: cfg.customerName };\n  board.customers.push(cust);\n  created = true;\n}\nif (!board.active || !board.data[board.active]) board.active = cust.id;\nconst bag = board.data[cust.id] = board.data[cust.id] || {};\n\n// 1. Drop everything the previous sync added. Hand-added analytics are untouched.\nlet removed = 0;\nfor (const t of Object.keys(bag)) {\n  const before = bag[t].length;\n  bag[t] = bag[t].filter(a => a.source !== 'sentinel');\n  removed += before - bag[t].length;\n  if (!bag[t].length) delete bag[t];\n}\n\n// 2. Place every Sentinel rule on each technique it is tagged with.\nconst matched = new Set();\nlet added = 0, updated = 0;\nconst noTechniques = [], remapped = [], retiredTags = [];\nfor (const r of rules) {\n  const p = r.properties || {};\n  const name = p.displayName || r.name;\n  let techs = [].concat(p.techniques || [], p.subTechniques || []);\n  techs = [...new Set(techs.map(t => {\n    if (remap[t]) { remapped.push(name + ': ' + t + ' -> ' + remap[t]); return remap[t]; }\n    if (retired.has(t)) retiredTags.push(name + ': ' + t);\n    return t;\n  }))];\n  if (!techs.length) { noTechniques.push(name); continue; }\n\n  const m = /^(CA-\\d{3,})/i.exec(name);\n  const ref = m ? m[1].toUpperCase() : '';\n  const status = p.enabled ? 'Enabled' : 'Disabled';\n  const sev = SEV[norm(p.severity)] || 'Medium';\n\n  // If this rule is already on the board by hand (same CA reference or name, any technique),\n  // keep your mapping: refresh status/severity on those entries and add nothing new.\n  const hits = [];\n  for (const t of Object.keys(bag)) for (const a of bag[t])\n    if (a.source !== 'sentinel' && ((ref && norm(a.id) === norm(ref)) || norm(a.name) === norm(name))) hits.push(a);\n  if (hits.length) {\n    for (const hit of hits) {\n      hit.status = status; hit.sev = sev;\n      hit.sentinelRuleId = r.name; hit.lastSynced = now;\n      if (!hit.kql && p.query) hit.kql = p.query;\n      matched.add(hit); updated++;\n    }\n    continue;\n  }\n\n  for (const t of techs) {\n    const arr = bag[t] = bag[t] || [];\n    {\n      arr.push({\n        id: ref, name, status, sev, url: '',\n        note: 'Synced from Sentinel (' + (r.kind || 'rule') + ')',\n        watchlists: [], kql: p.query || '',\n        source: 'sentinel', sentinelRuleId: r.name, lastSynced: now\n      });\n      added++;\n    }\n  }\n}\n\n// 3. Drift: analytics marked Enabled on the board that no Sentinel rule matched.\nconst notInSentinel = [];\nfor (const t of Object.keys(bag)) for (const a of bag[t])\n  if (a.source !== 'sentinel' && !matched.has(a) && a.status === 'Enabled')\n    notInSentinel.push(t + ' ' + (a.id ? a.id + ' ' : '') + a.name);\n\nboard.updated = now;\nboard.updatedBy = 'Sentinel sync';\n\nreturn {\n  content: JSON.stringify(board, null, 2),\n  summary: {\n    customer: cust.name, customerId: cust.id, customerViewCreated: created,\n    rulesRead: rules.length, previousSyncedEntriesRemoved: removed,\n    entriesAdded: added, handAddedEntriesUpdated: updated,\n    rulesWithNoTechniques: noTechniques, techniqueIdsRemapped: remapped,\n    retiredTechniquesWithNoReplacement: retiredTags,\n    enabledOnBoardButNotInSentinel: notInSentinel\n  }\n};\n",
                "explicitDependencies": {
                  "actions": [
                    "Config",
                    "All_rules",
                    "Board_text"
                  ]
                }
              }
            },
            "Merge_result": {
              "type": "Compose",
              "runAfter": {
                "Merge_into_board": [
                  "Succeeded"
                ]
              },
              "inputs": "@coalesce(body('Merge_into_board')?['result'], body('Merge_into_board'))"
            },
            "Summary": {
              "type": "Compose",
              "runAfter": {
                "Merge_result": [
                  "Succeeded"
                ]
              },
              "inputs": "@outputs('Merge_result')?['summary']"
            },
            "Write_unless_dry_run": {
              "type": "If",
              "runAfter": {
                "Summary": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@parameters('dryRun')",
                      false
                    ]
                  }
                ]
              },
              "actions": {
                "Write_board": {
                  "type": "ApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                      }
                    },
                    "method": "put",
                    "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/files/@{encodeURIComponent(body('Get_board_metadata')?['Id'])}",
                    "body": "@outputs('Merge_result')?['content']"
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
