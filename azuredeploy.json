        "T1562.011": "T1685.003",
        "T1562.012": "T1685.004",
        "T1562.013": "T1686.002",
        "T1574.002": "T1574.001",
        "T1656": "T1684.001",
        "T1672": "T1684.002"
      },
      "metadata": {
        "description": "Every revoked ATT&CK technique ID -> its current replacement, generated from MITRE's ATT&CK v20.0 STIX revoked-by relationships. Valid for the dashboard's v19.2 matrix (v20.0 retired nothing). Only edit to override a mapping."
      }
    },
    "sentinelApiVersion": {
      "type": "string",
      "defaultValue": "2024-09-01",
      "metadata": {
        "description": "Microsoft.SecurityInsights API version used to list analytics rules. Stable versions (including 2024-09-01) do not return the subTechniques property, so rules land only on parent technique tiles. Use a preview version that returns it, e.g. 2024-10-01-preview, to map rules onto the dashboard's sub-technique tiles as well."
      }
    },
    "assignSentinelReader": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Grant the Logic App's managed identity Microsoft Sentinel Reader on the workspace. Needs Owner/User Access Administrator there. Set false if done separately or via Azure Lighthouse."
      }
    },
    "createIntegrationAccount": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "The JavaScript merge step needs an integration account. true = create a Free-tier one. Free is limited to one per region per subscription; set false and fill existingIntegrationAccountId if you already have one."
      }
    },
    "integrationAccountName": {
      "type": "string",
      "defaultValue": "ia-mitre-board-sync",
      "metadata": {
        "description": "Name for the new integration account (only used when createIntegrationAccount is true)."
      }
    },
    "existingIntegrationAccountId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource ID of an existing integration account in the same region (only used when createIntegrationAccount is false)."
      }
    }
  },
  "variables": {
    "wsParts": "[split(parameters('workspaceResourceId'), '/')]",
    "spConnectionName": "[concat(parameters('logicAppName'), '-sharepoint')]",
    "iaId": "[if(parameters('createIntegrationAccount'), resourceId('Microsoft.Logic/integrationAccounts', parameters('integrationAccountName')), parameters('existingIntegrationAccountId'))]"
  },
  "resources": [
    {
      "condition": "[parameters('createIntegrationAccount')]",
      "type": "Microsoft.Logic/integrationAccounts",
      "apiVersion": "2019-05-01",
      "name": "[parameters('integrationAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Free"
      },
      "properties": {
        "state": "Enabled"
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('spConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "[concat('SharePoint - ', parameters('logicAppName'))]",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'sharepointonline')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('spConnectionName'))]",
        "[resourceId('Microsoft.Logic/integrationAccounts', parameters('integrationAccountName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "integrationAccount": {
          "id": "[variables('iaId')]"
        },
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "workspaceResourceId": {
              "type": "String"
            },
            "customerName": {
              "type": "String"
            },
            "sharePointSiteUrl": {
              "type": "String"
            },
            "boardFilePath": {
              "type": "String"
            },
            "sentinelApiVersion": {
              "type": "String"
            },
            "techniqueRemap": {
              "type": "Object"
            },
            "dryRun": {
              "type": "Bool"
            }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "timeZone": "[parameters('timeZone')]",
                "schedule": {
                  "hours": [
                    "[parameters('runHour')]"
                  ],
                  "minutes": [
                    0
                  ]
                }
              }
            }
          },
          "actions": {
            "Config": {
              "type": "Compose",
              "runAfter": {},
              "inputs": {
                "customerName": "@parameters('customerName')",
                "remap": "@parameters('techniqueRemap')"
              }
            },
            "Init_rules": {
              "type": "InitializeVariable",
              "runAfter": {
                "Config": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "variables": [
                  {
                    "name": "rules",
                    "type": "array",
                    "value": []
                  }
                ]
              }
            },
            "Init_nextUrl": {
              "type": "InitializeVariable",
              "runAfter": {
                "Init_rules": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "variables": [
                  {
                    "name": "nextUrl",
                    "type": "string",
                    "value": "https://management.azure.com@{parameters('workspaceResourceId')}/providers/Microsoft.SecurityInsights/alertRules?api-version=@{parameters('sentinelApiVersion')}"
                  }
                ]
              }
            },
            "Page_through_rules": {
              "type": "Until",
              "runAfter": {
                "Init_nextUrl": [
                  "Succeeded"
                ]
              },
              "expression": "@equals(variables('nextUrl'), '')",
              "limit": {
                "count": 50,
                "timeout": "PT1H"
              },
              "actions": {
                "Get_rules_page": {
                  "type": "Http",
                  "runAfter": {},
                  "inputs": {
                    "method": "GET",
                    "uri": "@variables('nextUrl')",
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "audience": "https://management.azure.com/"
                    }
                  }
                },
                "Collect": {
                  "type": "Compose",
                  "runAfter": {
                    "Get_rules_page": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@union(variables('rules'), coalesce(body('Get_rules_page')?['value'], json('[]')))"
                },
                "Set_rules": {
                  "type": "SetVariable",
                  "runAfter": {
                    "Collect": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "name": "rules",
                    "value": "@outputs('Collect')"
                  }
                },
                "Set_nextUrl": {
                  "type": "SetVariable",
                  "runAfter": {
                    "Set_rules": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "name": "nextUrl",
                    "value": "@{coalesce(body('Get_rules_page')?['nextLink'], '')}"
                  }
                }
              }
            },
            "All_rules": {
              "type": "Compose",
              "runAfter": {
                "Page_through_rules": [
                  "Succeeded"
                ]
              },
              "inputs": "@variables('rules')"
            },
            "Shape_entries": {
              "type": "Select",
              "runAfter": {
                "All_rules": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@outputs('All_rules')",
                "select": {
                  "techniques": "@union(coalesce(item()?['properties']?['techniques'], json('[]')), coalesce(item()?['properties']?['subTechniques'], json('[]')))",
                  "id": "@if(startswith(toupper(coalesce(item()?['properties']?['displayName'], item()?['name'])), 'CA-'), first(split(coalesce(item()?['properties']?['displayName'], item()?['name']), ' ')), '')",
                  "name": "@coalesce(item()?['properties']?['displayName'], item()?['name'])",
                  "status": "@if(equals(item()?['properties']?['enabled'], true), 'Enabled', 'Disabled')",
                  "sev": "@coalesce(item()?['properties']?['severity'], 'Medium')",
                  "url": "",
                  "note": "@concat('Synced from Sentinel (', coalesce(item()?['kind'], 'rule'), ')')",
                  "watchlists": "@json('[]')",
                  "kql": "@coalesce(item()?['properties']?['query'], '')",
                  "source": "sentinel",
                  "sentinelRuleId": "@item()?['name']",
                  "lastSynced": "@utcNow()"
                }
              }
            },
            "Get_board_metadata": {
              "type": "ApiConnection",
              "runAfter": {
                "Shape_entries": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/GetFileByPath",
                "queries": {
                  "path": "@parameters('boardFilePath')",
                  "queryParametersSingleEncoded": true
                }
              }
            },
            "Get_board": {
              "type": "ApiConnection",
              "runAfter": {
                "Get_board_metadata": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/GetFileContentByPath",
                "queries": {
                  "path": "@parameters('boardFilePath')",
                  "inferContentType": false,
                  "queryParametersSingleEncoded": true
                }
              }
            },
            "Board_text": {
              "type": "Compose",
              "runAfter": {
                "Get_board": [
                  "Succeeded"
                ]
              },
              "inputs": "@base64ToString(coalesce(body('Get_board')?['$content'], base64(string(body('Get_board')))))"
            },
            "Merge_into_board": {
              "type": "JavaScriptCode",
              "runAfter": {
                "Board_text": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "code": "const A=workflowContext.actions,c=A.Config.outputs,m=c.remap||{},L=s=>String(s||'').trim().toLowerCase();\nconst b=JSON.parse(String(A.Board_text.outputs).trim());\nb.v=b.v||3;b.customers=b.customers||[];b.data=b.data||{};\nlet u=b.customers.find(x=>L(x.name)===L(c.customerName));\nif(!u){u={id:'c'+Math.random().toString(36).slice(2,9),name:c.customerName};b.customers.push(u)}\nif(!b.active)b.active=u.id;\nconst R=A.Shape_entries.outputs||[],g={};let k=0;\nfor(const r of R){const{techniques:T,...e}=r;for(const x of new Set((T||[]).map(y=>m[y]||y))){(g[x]=g[x]||[]).push(e);k++}}\nconst o=b.data[u.id]||{};\nfor(const x in o){const h=o[x].filter(a=>a.source!=='sentinel');if(h.length)g[x]=(g[x]||[]).concat(h)}\nb.data[u.id]=g;b.updated=new Date().toISOString();b.updatedBy='Sentinel sync';\nreturn{content:JSON.stringify(b,null,2),summary:{customer:u.name,rulesRead:R.length,entriesWritten:k,techniquesCovered:Object.keys(g).length}};\n",
                "explicitDependencies": {
                  "actions": [
                    "Config",
                    "Shape_entries",
                    "Board_text"
                  ]
                }
              }
            },
            "Merge_result": {
              "type": "Compose",
              "runAfter": {
                "Merge_into_board": [
                  "Succeeded"
                ]
              },
              "inputs": "@coalesce(body('Merge_into_board')?['result'], body('Merge_into_board'))"
            },
            "Summary": {
              "type": "Compose",
              "runAfter": {
                "Merge_result": [
                  "Succeeded"
                ]
              },
              "inputs": "@outputs('Merge_result')?['summary']"
            },
            "Write_unless_dry_run": {
              "type": "If",
              "runAfter": {
                "Summary": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@parameters('dryRun')",
                      false
                    ]
                  }
                ]
              },
              "actions": {
                "Write_board": {
                  "type": "ApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                      }
                    },
                    "method": "put",
                    "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/files/@{encodeURIComponent(body('Get_board_metadata')?['Id'])}",
                    "body": "@outputs('Merge_result')?['content']"
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "sharepointonline": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('spConnectionName'))]",
                "connectionName": "[variables('spConnectionName')]",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'sharepointonline')]"
              }
            }
          },
          "workspaceResourceId": {
            "value": "[parameters('workspaceResourceId')]"
          },
          "customerName": {
            "value": "[parameters('customerName')]"
          },
          "sharePointSiteUrl": {
            "value": "[parameters('sharePointSiteUrl')]"
          },
          "boardFilePath": {
            "value": "[parameters('boardFilePath')]"
          },
          "sentinelApiVersion": {
            "value": "[parameters('sentinelApiVersion')]"
          },
          "techniqueRemap": {
            "value": "[parameters('techniqueRemap')]"
          },
          "dryRun": {
            "value": "[parameters('dryRun')]"
          }
        }
      }
    },
    {
      "condition": "[parameters('assignSentinelReader')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[concat(parameters('logicAppName'), '-sentinel-reader')]",
      "subscriptionId": "[variables('wsParts')[2]]",
      "resourceGroup": "[variables('wsParts')[4]]",
      "dependsOn": [
        "[resourceId('Microsoft.Logic/workflows', parameters('logicAppName'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "workspaceName": {
            "value": "[variables('wsParts')[8]]"
          },
          "principalId": {
            "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'full').identity.principalId]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "workspaceName": {
              "type": "string"
            },
            "principalId": {
              "type": "string"
            }
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[format('Microsoft.OperationalInsights/workspaces/{0}', parameters('workspaceName'))]",
              "name": "[guid(resourceGroup().id, parameters('workspaceName'), parameters('principalId'), 'sentinel-reader')]",
              "properties": {
